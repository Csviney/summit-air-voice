OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
TWILIO_AUTH_TOKEN=
# Public HTTPS origin only (e.g. your ngrok domain), no path or trailing query.
TWILIO_PUBLIC_BASE_URL=https://example.ngrok-free.app
PORT=3000

# Password for /demo (user "demo"); at least 12 characters.
DEMO_PASSWORD=
DATABASE_PATH=var/summit-air.db

TWILIO_ACCOUNT_SID=
# The Twilio number callers dial; used as caller ID on transfers. E.164, e.g. +19195550100
TWILIO_PHONE_NUMBER=
# The only number critical calls are transferred to. Must differ from the phone you test from.
TRANSFER_PHONE_NUMBER=

# Google Calendar for urgent visits. Run `npm run google-auth` once to get the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar ID of the dedicated demo calendar (Google Calendar → Settings → Integrate calendar).
GOOGLE_CALENDAR_ID=
