{
  "name": "summit-air-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=30000 tests/*.test.ts",
    "data": "tsx --env-file-if-exists=.env scripts/data.ts",
    "google-auth": "tsx --env-file-if-exists=.env scripts/google-auth.ts"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.1",
    "@openai/agents": "0.18.0",
    "@openai/agents-extensions": "0.18.0",
    "fastify": "5.12.5",
    "tsx": "4.23.15",
    "twilio": "6.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "ws": "8.22.0"
  }
}
